{
    "ci": {
        "collect": {
            "startServerCommand": "npm start",
            "url": [
                "http://localhost:8000/"
            ],
            "numberOfRuns": 3,
            "settings": {
                "preset": "desktop"
            },
            "startServerReadyPattern": "Available on"
        },
        "assert": {
            "assertions": {
                "categories:performance": [
                    "error",
                    {
                        "minScore": 0.95
                    }
                ],
                "categories:accessibility": [
                    "error",
                    {
                        "minScore": 1
                    }
                ],
                "categories:best-practices": [
                    "error",
                    {
                        "minScore": 1
                    }
                ],
                "categories:seo": [
                    "error",
                    {
                        "minScore": 1
                    }
                ]
            }
        },
        "upload": {
            "target": "filesystem",
            "outputDir": ".lighthouseci/reports"
        }
    }
}
